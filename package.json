{
    "name": "daily-notes-editor",
    "version": "1.1.0",
    "description": "A plugin for you to edit a bunch of daily notes in one page(inline), which works similar to Roam Research's default daily note view.",
    "main": "main.js",
    "scripts": {
        "flint": "npx eslint --config eslint.config.mjs --fix . && npm run flintq",
        "flintq": "pnpm dlx jscodeshift -t ./codemods/single-quote-import.ts src --parser=ts",
        "lint": "npx eslint --fix --ext .ts,.svelte .",
        "dev": "npm run flint && vite build --watch --mode development",
        "build": "npx svelte-check && vite build --mode production",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "type": "module",
    "keywords": [],
    "author": "Quorafind",
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.28.0",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-replace": "^5.0.5",
        "@rollup/plugin-terser": "^0.4.4",
        "@sveltejs/vite-plugin-svelte": "^3.1.0",
        "@tsconfig/svelte": "^5.0.4",
        "@types/node": "^20.12.7",
        "@typescript-eslint/eslint-plugin": "6.21.0",
        "@typescript-eslint/parser": "6.21.0",
        "builtin-modules": "3.3.0",
        "esbuild": "0.14.47",
        "eslint": "^9.28.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-svelte": "^2.37.0",
        "globals": "^16.2.0",
        "obsidian": "^1.8.7",
        "obsidian-daily-notes-interface": "^0.9.4",
        "svelte": "^5.34.1",
        "svelte-check": "3.7.1",
        "svelte-eslint-parser": "^1.2.0",
        "svelte-inview": "^4.0.2",
        "svelte-preprocess": "^5.1.4",
        "tslib": "2.4.0",
        "typescript": "5.3.3",
        "vite": "^5.2.10"
    },
    "dependencies": {
        "@codemirror/state": "^6.5.2",
        "@codemirror/view": "^6.36.3",
        "monkey-around": "^2.3.0"
    },
    "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}