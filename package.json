{
    "name": "daily-notes-editor",
    "version": "1.1.0",
    "description": "A plugin for you to edit a bunch of daily notes in one page(inline), which works similar to Roam Research's default daily note view.",
    "main": "main.js",
    "scripts": {
        "xlint": "pnpm dlx eslint --fix --config eslint.config.mjs .",
        "lint": "pnpm dlx eslint --fix --ext .ts,.svelte .",
        "dev": "pnpm xlint && vite build --config vite.config.mts --watch --mode development",
        "build": "pnpm dlx svelte-check && vite --config vite.config.mts build --mode production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "odev": "IS_PROTOTYPING=false vite build --config vite.config.mts --watch --mode development",
        "code-docs": "typedoc \"src/**/*\""
    },
    "type": "module",
    "keywords": [],
    "author": "Quorafind",
    "devDependencies": {
        "@codemirror/language": "^6.11.1",
        "@codemirror/state": "^6.5.2",
        "@codemirror/view": "^6.36.3",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.29.0",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-replace": "^5.0.5",
        "@rollup/plugin-terser": "^0.4.4",
        "@sveltejs/vite-plugin-svelte": "^3.1.0",
        "@tsconfig/svelte": "^5.0.4",
        "@types/node": "^20.12.7",
        "@types/pino": "^7.0.5",
        "@typescript-eslint/eslint-plugin": "6.21.0",
        "@typescript-eslint/parser": "6.21.0",
        "builtin-modules": "3.3.0",
        "chalk": "^5.4.1",
        "copy-newer": "^2.1.2",
        "dayjs": "^1.11.13",
        "esbuild": "0.14.47",
        "eslint": "^9.29.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-svelte": "^2.37.0",
        "fs-extra": "^11.3.0",
        "globals": "^16.2.0",
        "obsidian": "^1.8.7",
        "obsidian-daily-notes-interface": "^0.9.4",
        "pino": "^9.7.0",
        "svelte": "^4.2.15",
        "svelte-check": "3.7.1",
        "svelte-eslint-parser": "^0.35.0",
        "svelte-inview": "^4.0.2",
        "svelte-preprocess": "^5.1.4",
        "tslib": "2.4.0",
        "typedoc": "^0.28.5",
        "typedoc-plugin-mdn-links": "^5.0.2",
        "typescript": "5.3.3",
        "vite": "link:@sveltjs/kit/vite"
    },
    "dependencies": {
        "@sveltejs/kit": "^2.21.5",
        "monkey-around": "^2.3.0"
    },
    "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}