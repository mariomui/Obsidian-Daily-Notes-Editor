{
    "compilerOptions": {
        "baseUrl": ".",
        "allowSyntheticDefaultImports": true,
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES6",
        "allowJs": true,
        "noImplicitAny": false,
        "moduleResolution": "node",
        "importHelpers": true,
        "isolatedModules": true,
        "strictNullChecks": true,
        "lib": [
            "DOM",
            "ES5",
            "ES6",
            "ES7"
        ],
        "types": [
            "node"
        ],
        "paths": {
            "utils/*": [
                "utils/*"
            ]
        },
    },
    //	"extends": "@tsconfig/svelte/tsconfig.json",
    "types": [
        "node",
        "obsidian"
    ],
    "typeRoots": [
        "./node_modules/@types",
        "./types",
        "./node_modules/eslint/lib/types"
    ],
    "include": [
        "**/globals.d.ts",
        "**/*.js",
        "**/*.svelte",
        "**/*.ts",
    ],
    "exclude": [
        "dist/**.*"
    ]
}